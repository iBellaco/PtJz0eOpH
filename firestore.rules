rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function account() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && (request.auth.token.get('admin', false) == true || account().get('role', '') == 'admin'); }
    function isModerator() { return signedIn() && (account().get('role', '') == 'moderador' || account().get('secondaryRole', '') == 'moderador'); }
    function isStreamer() { return signedIn() && (account().get('role', '') == 'streamer' || account().get('secondaryRole', '') == 'streamer'); }
    function sponsor(data) { return data.get('tag', data.get('type', '')).upper() in ['PATROCINADOR', 'PATROCINIO', 'SPONSOR', 'PUBLICIDAD']; }
    function ownsTicket(data) {
      return signedIn() && (data.get('userId', '') == request.auth.uid ||
        (data.get('userId', '') == '' && request.auth.token.get('email', '') != '' && data.get('userEmail', '') == request.auth.token.email));
    }
    function staffTicket(data) { return isAdmin() || (isModerator() && data.get('staffVisible', false) == true); }
    function closed(data) { return data.get('status', '').upper() in ['SOLVED', 'SOLUCIONADO', 'RESUELTO', 'CLOSED', 'CERRADO', 'COMPLETED', 'COMPLETADO']; }
    function userReadUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead','userRead','hasNewReply','hasNewAdminReply','userReadAtMillis','updatedAt'])
        && request.resource.data.get('userRead', false) == true && request.resource.data.get('hasNewAdminReply', false) == false;
    }
    function userReply() {
      let old = resource.data.get('conversation', []);
      let next = request.resource.data.conversation;
      let last = next[next.size()-1];
      return !closed(resource.data) && old.size() > 0 && next.size() == old.size()+1
        && next.removeAll([last]) == old && last.senderRole == 'USER' && last.senderUid == request.auth.uid
        && last.text is string && last.text.size() > 0 && last.text.size() <= 10000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conversation','status','isCompleted','lastUserMessage','lastUserMessageAt','lastMessageAt','updatedAt','lastReplyRole','staffRead','isRead','userRead','hasNewAdminReply','hasNewReply','userId'])
        && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'PENDING'
        && request.resource.data.isCompleted == false && request.resource.data.staffRead == false;
    }
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == 'free'
        && !request.resource.data.keys().hasAny(['banned','premiumUntil','secondaryRole','isVerified','verified','admin'])
        && request.resource.data.get('registeredDevices', []).size() <= 2;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','secondaryRole','premiumUntil','banned','isVerified','verified','admin'])
        && request.resource.data.get('registeredDevices', []).size() <= 2);
      allow delete: if false;
      match /messages/{messageId} {
        function source() { return getAfter(/databases/$(database)/documents/support_reports/$(messageId)).data; }
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin() || (signedIn() && request.auth.uid == userId) ||
          (isModerator() && source().userId == userId && source().get('staffVisible', false) == true && !sponsor(source())
            && request.resource.data.get('status', source().status) == source().status
            && request.resource.data.get('conversation', source().get('conversation', [])) == source().get('conversation', [])
            && request.resource.data.get('userRead', source().get('userRead', false)) == source().get('userRead', false));
      }
      match /subscription_history/{id} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }
    match /support_reports/{reportId} {
      allow create: if isAdmin() || (signedIn() && request.resource.data.get('category', '') == 'MODERATOR_REQUEST' && isModerator()) ||
        (signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.userEmail == request.auth.token.email
          && request.resource.data.staffVisible == !sponsor(request.resource.data)
          && request.resource.data.status == 'PENDING' && request.resource.data.get('adminReply', '') == ''
          && request.resource.data.conversation.size() == 2
          && request.resource.data.conversation[0].senderRole == 'USER' && request.resource.data.conversation[0].senderUid == request.auth.uid
          && request.resource.data.conversation[1].senderRole == 'SYSTEM'
          && request.resource.data.conversation[1].senderUid == ''
          && request.resource.data.conversation[1].text == 'Hola. El sistema ha recibido tu mensaje. El equipo de Coach te responderá aquí.');
      allow read: if ownsTicket(resource.data) || staffTicket(resource.data);
      allow update: if isAdmin() || (staffTicket(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId','userEmail','tag','type','staffVisible'])) ||
        (ownsTicket(resource.data) && (userReadUpdate() || userReply()));
      allow delete: if ownsTicket(resource.data) || staffTicket(resource.data);
    }
    function validChannel(url) {
      return url is string && url.size() <= 300 && (
        url.matches('https://tiktok[.]com/@[A-Za-z0-9_.]{2,24}(/live)?') ||
        url.matches('https://youtube[.]com/(@[^/?#%]{3,30}|channel/UC[A-Za-z0-9_-]{22}|c/[A-Za-z0-9_.-]{1,100}|user/[A-Za-z0-9_.-]{1,100})(/live)?') ||
        url.matches('https://(twitch[.]tv|kick[.]com)/[A-Za-z0-9_-]{3,25}'));
    }
    function liveEntries() { return exists(/databases/$(database)/documents/system_config/streamer_live) ? get(/databases/$(database)/documents/system_config/streamer_live).data.get('entries', []) : []; }
    match /streamer_requests/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if isAdmin() || (isStreamer() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['userId','userName','channelName','channelUrl','platform','status','usingCoachAcknowledged','submittedAtMillis'])
        && request.resource.data.userId == userId && request.resource.data.status == 'PENDING'
        && request.resource.data.usingCoachAcknowledged == true && request.resource.data.channelName is string
        && request.resource.data.channelName.size() >= 2 && request.resource.data.channelName.size() <= 60
        && validChannel(request.resource.data.channelUrl) && liveEntries().size() < 5
        && (!exists(/databases/$(database)/documents/streamer_requests/$(userId)) || resource.data.status != 'PENDING')) ||
        (signedIn() && request.auth.uid == userId && resource.data.status == 'APPROVED' && request.resource.data.status == 'ENDED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAtMillis']));
      allow delete: if isAdmin();
    }
    match /system_config/{document} {
      allow read: if signedIn();
      allow write: if document != 'streamer_live' && isAdmin();
    }
    match /system_config/streamer_live {
      function ownRemoval(index) {
        let old = resource.data.entries;
        let next = request.resource.data.entries;
        return old.size() > index && old[index].userId == request.auth.uid && next == old.removeAll([old[index]]);
      }
      allow create: if isAdmin() && request.resource.data.entries.size() <= 5;
      allow update: if request.resource.data.entries is list && request.resource.data.entries.size() <= 5 &&
        (isAdmin() || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entries']) &&
          (ownRemoval(0) || ownRemoval(1) || ownRemoval(2) || ownRemoval(3) || ownRemoval(4))));
      allow delete: if isAdmin();
    }
    match /moderator_requests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isModerator() && request.resource.data.status == 'PENDIENTE';
    }
  }
}
