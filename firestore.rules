rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function account() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && (request.auth.token.get('admin', false) == true || account().get('role', '') == 'admin'); }
    function isModerator() { return signedIn() && (account().get('role', '') == 'moderador' || account().get('secondaryRole', '') == 'moderador'); }
    function isStreamer() { return signedIn() && (account().get('role', '') == 'streamer' || account().get('secondaryRole', '') == 'streamer'); }
    function sponsor(data) {
      let tags = ['PATROCINADOR', 'PATROCINIO', 'SPONSOR', 'PUBLICIDAD'];
      return data.get('tag', '').upper() in tags || data.get('type', '').upper() in tags || data.get('category', '').upper() in tags;
    }
    function ownsTicket(data) {
      return signedIn() && (data.get('userId', '') == request.auth.uid ||
        (data.get('userId', '') == '' && request.auth.token.get('email', '') != '' && data.get('userEmail', '') == request.auth.token.email));
    }
    function staffTicket(data) { return isAdmin() || (isModerator() && data.get('staffVisible', false) == true); }
    function closed(data) { return data.get('status', '').upper() in ['SOLVED', 'SOLUCIONADO', 'RESUELTO', 'CLOSED', 'CERRADO', 'COMPLETED', 'COMPLETADO']; }
    function userReadUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead','userRead','hasNewReply','hasNewAdminReply','userReadAtMillis','updatedAt'])
        && request.resource.data.get('userRead', false) == true && request.resource.data.get('hasNewAdminReply', false) == false;
    }
    function userReply() {
      let old = resource.data.get('conversation', []);
      let next = request.resource.data.conversation;
      let last = next[next.size()-1];
      return !closed(resource.data) && resource.data.get('userCanReply', false) == true && old.size() > 0 && next.size() == old.size()+1
        && next.removeAll([last]) == old && last.senderRole == 'USER' && last.senderUid == request.auth.uid
        && last.text is string && last.text.size() > 0 && last.text.size() <= 10000
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conversation','status','isCompleted','lastUserMessage','lastUserMessageAt','lastMessageAt','updatedAt','lastReplyRole','staffRead','isRead','userRead','hasNewAdminReply','hasNewReply','userId'])
        && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'PENDING'
        && request.resource.data.isCompleted == false && request.resource.data.staffRead == false;
    }
    function staffReply() {
      let old = resource.data.get('conversation', []);
      let next = request.resource.data.get('conversation', []);
      let last = next[next.size()-1];
      return !closed(resource.data) && next.size() == old.size()+1 && next.removeAll([last]) == old
        && last.senderRole == 'SUPPORT' && last.senderUid == request.auth.uid
        && last.get('isGreeting', false) == false
        && last.text != 'Hola. El sistema ha recibido tu mensaje. El equipo de Coach te responderá aquí.';
    }
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.role == 'free'
        && !request.resource.data.keys().hasAny(['banned','premiumUntil','secondaryRole','isVerified','verified','admin'])
        && request.resource.data.get('registeredDevices', []).size() <= 2;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','secondaryRole','premiumUntil','banned','isVerified','verified','admin'])
        && request.resource.data.get('registeredDevices', []).size() <= 2);
      allow delete: if false;
      match /messages/{messageId} {
        function source() { return getAfter(/databases/$(database)/documents/support_reports/$(messageId)).data; }
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow delete: if isAdmin();
        allow create, update: if isAdmin() || (signedIn() && request.auth.uid == userId) ||
          (isModerator() && source().userId == userId && source().get('staffVisible', false) == true && !sponsor(source())
            && request.resource.data.get('status', source().status) == source().status
            && request.resource.data.get('conversation', source().get('conversation', [])) == source().get('conversation', [])
            && request.resource.data.get('userRead', source().get('userRead', false)) == source().get('userRead', false));
      }
      match /subscription_history/{id} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }
    // Avisos públicos y notificaciones generales
    match /app_notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /global_notifications/{notificationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /support_reports/{reportId} {
      allow create: if isAdmin() || (signedIn() && request.resource.data.get('category', '') == 'MODERATOR_REQUEST' && isModerator()) ||
        (signedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.userEmail == request.auth.token.email
          && request.resource.data.staffVisible == !sponsor(request.resource.data)
          && request.resource.data.status == 'PENDING' && request.resource.data.get('adminReply', '') == ''
          && request.resource.data.get('userCanReply', false) == false
          && request.resource.data.conversation.size() == 2
          && request.resource.data.conversation[0].senderRole == 'USER' && request.resource.data.conversation[0].senderUid == request.auth.uid
          && request.resource.data.conversation[1].senderRole == 'SYSTEM'
          && request.resource.data.conversation[1].senderUid == ''
          && request.resource.data.conversation[1].text == 'Hola. El sistema ha recibido tu mensaje. El equipo de Coach te responderá aquí.');
      allow read: if ownsTicket(resource.data) || staffTicket(resource.data);
      allow update: if isAdmin() || (staffTicket(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId','userEmail','tag','type','staffVisible'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['conversation']) || staffReply())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userCanReply']) || (staffReply() && request.resource.data.userCanReply == true))) ||
        (ownsTicket(resource.data) && (userReadUpdate() || userReply()));
      allow delete: if isAdmin();
    }
    match /feedbacks/{feedbackId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    function validChannel(url) {
      return url is string && url.size() <= 300 && (
        url.matches('https://tiktok[.]com/@[A-Za-z0-9_.]{2,24}(/live)?') ||
        url.matches('https://youtube[.]com/(@([A-Za-z0-9_.-]|%[A-Fa-f0-9]{2}){3,120}|channel/UC[A-Za-z0-9_-]{22}|c/[A-Za-z0-9_.-]{1,100}|user/[A-Za-z0-9_.-]{1,100})(/live)?') ||
        (url.matches('https://(twitch[.]tv|kick[.]com)/[A-Za-z0-9_-]{3,25}') && !url.matches('https://(twitch[.]tv|kick[.]com)/(directory|videos|downloads|settings|login|signup|search|wallet|inventory|subscriptions|categories|browse|dashboard)')));
    }
    function liveEntries() { return exists(/databases/$(database)/documents/system_config/streamer_live) ? get(/databases/$(database)/documents/system_config/streamer_live).data.get('entries', []) : []; }
    function alreadyLive(uid) {
      let entries = liveEntries();
      return (entries.size() > 0 && entries[0].userId == uid) || (entries.size() > 1 && entries[1].userId == uid)
        || (entries.size() > 2 && entries[2].userId == uid) || (entries.size() > 3 && entries[3].userId == uid) || (entries.size() > 4 && entries[4].userId == uid);
    }
    function streamerSubmittedMillis(data) {
      return data.get('submittedAt', null) is timestamp ? data.submittedAt.toMillis() : data.get('submittedAtMillis', 0);
    }
    function streamerExpired(data) {
      return data.get('status', '') == 'PENDING' && request.time.toMillis() >= streamerSubmittedMillis(data) + 10800000;
    }
    function publicationId(data) { return data.get('publicationId', 'legacy_' + string(streamerSubmittedMillis(data))); }
    function validStreamerHistoryDeadline(data) {
      return !data.keys().hasAny(['streamerHistoryDeleteAt']) ||
        (data.streamerHistoryDeleteAt is timestamp && data.streamerHistoryDeleteAt.toMillis() == data.get('submittedAtMillis', 0) + 604800000);
    }
    function streamerHistoryExpired(data) {
      return streamerSubmittedMillis(data) > 0 && request.time.toMillis() >= streamerSubmittedMillis(data) + 604800000;
    }
    function timeoutCopy(copy, original) {
      return streamerExpired(original) && copy.get('status', '') == 'REJECTED' && copy.get('rejectionReason', '') == 'TIMEOUT'
        && copy.get('reviewedAtMillis', 0) == streamerSubmittedMillis(original) + 10800000
        && copy.diff(original).affectedKeys().hasOnly(['status', 'rejectionReason', 'reviewedAtMillis']);
    }
    match /streamer_requests/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if (isAdmin() && (request.resource.data.get('status', '') != 'APPROVED' || !streamerExpired(resource.data))) ||
        (isStreamer() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['userId','userName','channelName','channelUrl','platform','status','usingCoachAcknowledged','submittedAtMillis','submittedAt','publicationId','streamerHistoryDeleteAt'])
        && request.resource.data.userId == userId && request.resource.data.status == 'PENDING'
        && request.resource.data.usingCoachAcknowledged == true && request.resource.data.channelName is string
        && request.resource.data.channelName.size() >= 2 && request.resource.data.channelName.size() <= 60
        && validChannel(request.resource.data.channelUrl) && liveEntries().size() < 5 && !alreadyLive(userId)
        && validStreamerHistoryDeadline(request.resource.data)
        && request.resource.data.submittedAt == request.time && request.resource.data.publicationId is string
        && request.resource.data.publicationId.size() >= 8 && request.resource.data.publicationId.size() <= 80
        && request.resource.data.submittedAtMillis >= request.time.toMillis() - 60000
        && request.resource.data.submittedAtMillis <= request.time.toMillis() + 60000
        && (!exists(/databases/$(database)/documents/streamer_requests/$(userId)) || resource.data.status != 'PENDING' || streamerExpired(resource.data))) ||
        (signedIn() && request.auth.uid == userId && resource.data.status == 'APPROVED' && request.resource.data.status == 'ENDED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','endedAtMillis']));
      allow delete: if (isAdmin() || (signedIn() && request.auth.uid == userId)) && streamerExpired(resource.data)
        && (streamerHistoryExpired(resource.data) || timeoutCopy(getAfter(/databases/$(database)/documents/streamer_requests/$(userId)/history/$(publicationId(resource.data))).data, resource.data));
      match /history/{historyId} {
        function latest() { return getAfter(/databases/$(database)/documents/streamer_requests/$(userId)).data; }
        function previous() { return get(/databases/$(database)/documents/streamer_requests/$(userId)).data; }
        allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
        function ownerHistoryWrite() {
          return signedIn() && request.auth.uid == userId && (
            (historyId == latest().get('publicationId', '') && request.resource.data == latest() && latest().status in ['PENDING','ENDED']) ||
            (historyId == publicationId(previous()) && request.resource.data == previous() && previous().status != 'PENDING') ||
            (historyId == publicationId(previous()) && timeoutCopy(request.resource.data, previous())));
        }
        allow create: if !streamerHistoryExpired(request.resource.data) && (isAdmin() || ownerHistoryWrite());
        allow update: if !streamerHistoryExpired(request.resource.data) && (isAdmin() || (ownerHistoryWrite() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','endedAtMillis','reviewedAtMillis','rejectionReason'])));
        allow delete: if (isAdmin() || (signedIn() && request.auth.uid == userId)) && streamerHistoryExpired(resource.data);
      }
    }
    match /system_config/{document} {
      allow read: if signedIn();
      allow write: if document != 'streamer_live' && isAdmin();
    }
    match /system_config/{document}/{nested=**} {
      allow read: if signedIn();
      allow write: if document != 'streamer_live' && isAdmin();
    }
    match /system_config/streamer_live {
      allow get: if true;
      function ownRemoval(index) {
        let old = resource.data.entries;
        let next = request.resource.data.entries;
        return old.size() > index && old[index].userId == request.auth.uid && next == old.removeAll([old[index]]);
      }
      allow create: if isAdmin() && request.resource.data.entries.size() <= 5;
      allow update: if request.resource.data.entries is list && request.resource.data.entries.size() <= 5 &&
        (isAdmin() || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entries']) &&
          (ownRemoval(0) || ownRemoval(1) || ownRemoval(2) || ownRemoval(3) || ownRemoval(4))));
      allow delete: if isAdmin();
    }
    match /streamer_click_metrics/{id} {
      function activePublication() {
        let entries = liveEntries();
        return (entries.size() > 0 && entries[0].get('publicationId', '') == id && entries[0].userId == resource.data.userId)
          || (entries.size() > 1 && entries[1].get('publicationId', '') == id && entries[1].userId == resource.data.userId)
          || (entries.size() > 2 && entries[2].get('publicationId', '') == id && entries[2].userId == resource.data.userId)
          || (entries.size() > 3 && entries[3].get('publicationId', '') == id && entries[3].userId == resource.data.userId)
          || (entries.size() > 4 && entries[4].get('publicationId', '') == id && entries[4].userId == resource.data.userId);
      }
      allow read: if isAdmin() || (signedIn() && request.auth.uid == resource.data.userId);
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['userId','publicationId','submittedAtMillis','clickCount','streamerHistoryDeleteAt'])
        && validStreamerHistoryDeadline(request.resource.data)
        && request.resource.data.publicationId == id && request.resource.data.clickCount == 0
        && request.resource.data.submittedAtMillis is int && request.resource.data.submittedAtMillis > 0
        && !streamerHistoryExpired(request.resource.data);
      allow update: if activePublication() && !streamerHistoryExpired(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount','lastClickedAt'])
        && request.resource.data.clickCount is int && request.resource.data.clickCount == resource.data.clickCount + 1
        && request.resource.data.lastClickedAt == request.time;
      allow delete: if (isAdmin() || (signedIn() && request.auth.uid == resource.data.userId)) && streamerHistoryExpired(resource.data);
    }
    match /moderator_requests/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if isModerator() && request.resource.data.status == 'PENDIENTE';
    }
  }
}
